# Editor settings shared by Android Studio, VS Code and others: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
