# Copy to keystore.properties (ignored by git) and fill in on your own machine.
# Paths may be absolute or relative to the project root. Never commit the real file or the key.
# The same values can come from the environment instead: PIXELPET_STORE_FILE,
# PIXELPET_STORE_PASSWORD, PIXELPET_KEY_ALIAS, PIXELPET_KEY_PASSWORD.
storeFile=/path/to/upload-keystore.jks
storePassword=
keyAlias=
keyPassword=
