<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка питомца: idle-кадр, имя и короткое описание. Выбранная залита акцентом. -->
<com.example.pixelpetwidget.ui.pixel.PixelCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/tile_pet"
        android:layout_width="@dimen/px_pet_card_image"
        android:layout_height="@dimen/px_pet_card_image"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <com.example.pixelpetwidget.ui.pixel.PixelLabel
        android:id="@+id/tile_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/px_stroke"
        android:gravity="center"
        android:maxLines="1" />

    <com.example.pixelpetwidget.ui.pixel.PixelLabel
        android:id="@+id/tile_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:pixelText="hint" />
</com.example.pixelpetwidget.ui.pixel.PixelCard>
