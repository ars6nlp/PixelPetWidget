    <!-- Наименьший размер кнопки, переключателя и карточки под палец -->
    <dimen name="px_touch">48dp</dimen>
    <!-- Отступы -->
    <dimen name="px_screen_padding">16dp</dimen>
    <dimen name="px_card_padding">12dp</dimen>
    <dimen name="px_gap">8dp</dimen>
    <dimen name="px_section_gap">24dp</dimen>
    <!-- Шире не растягиваем: планшеты и поворот экрана -->
